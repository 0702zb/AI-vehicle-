# Copy into the deployment secret manager; do not commit real credentials.
APP_ENV=prod
DATABASE_URL=postgresql://<user>:<password>@<postgres-host>:5432/concept_platform?sslmode=verify-full
REDIS_URL=rediss://:<password>@<redis-host>:6379/0
OBJECT_STORE_BACKEND=s3
OBJECT_STORE_BUCKET=<approved-private-bucket>
OBJECT_STORE_REGION=ap-east-1
OBJECT_STORE_ENDPOINT_URL=
OUTBOX_RETRY_OWNER=fencing_token
LANGGRAPH_NODE_RETRIES=0
OBSERVABILITY_BACKEND=event_table
